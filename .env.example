# ============================================
# RATBV Brașov - Variabile de Mediu
# ============================================
# Copiază acest fișier ca .env și completează valorile

# ============================================
# SUPABASE (Bază de date)
# ============================================

# URL-ul proiectului tău Supabase
# Format: https://xxxxx.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Cheia anonimă (anon key) din Supabase
# O găsești în: Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# EMAIL (Verificare Email OTP) - RECOMANDAT (GRATUIT!)
# ============================================

# Adresa de email Gmail (sau alt provider)
EMAIL_USER=your-email@gmail.com

# App Password Gmail (16 caractere, FĂRĂ spații)
# Generează la: https://myaccount.google.com/apppasswords
EMAIL_PASS=abcdefghijklmnop

# Numele expeditorului (opțional)
EMAIL_FROM="RATBV Brașov" <your-email@gmail.com>

# ============================================
# TWILIO (Verificare SMS) - OPȚIONAL (SCUMP!)
# ============================================

# Account SID din Twilio Console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token din Twilio Console (SECRET!)
TWILIO_AUTH_TOKEN=your_auth_token_here

# Număr de telefon Twilio (cu format internațional)
TWILIO_PHONE_NUMBER=+40712345678

# ============================================
# INSTRUCȚIUNI RAPIDE:
# ============================================
# 
# PENTRU BAZA DE DATE (Supabase):
# 1. Mergi la https://supabase.com și creează cont
# 2. Creează un proiect nou (gratuit)
# 3. Așteaptă ~2 minute să se inițializeze
# 4. Mergi la SQL Editor și rulează conținutul din supabase/schema.sql
# 5. Mergi la Settings > API și copiază:
#    - Project URL → pune-l la VITE_SUPABASE_URL
#    - anon public key → pune-l la VITE_SUPABASE_ANON_KEY
#
# PENTRU EMAIL (Recomandat - GRATUIT):
# 1. Mergi la https://myaccount.google.com/apppasswords
# 2. Loghează-te cu contul Gmail
# 3. Generează App Password (16 caractere)
# 4. Completează variabilele EMAIL_* de mai sus
# 5. Pornește serverul email: node server-email.js
#
# PENTRU SMS (Opțional - SCUMP ~0.35 RON/SMS):
# 1. Mergi la https://www.twilio.com/try-twilio și creează cont
# 2. Mergi la Console: https://console.twilio.com
# 3. Copiază Account SID și Auth Token
# 4. Cumpără un număr de telefon cu capabilitate SMS
# 5. Completează variabilele TWILIO_* de mai sus
# 6. Pornește serverul SMS: node server.js
#
# FINALIZARE:
# 7. Salvează acest fișier ca .env
# 8. Repornește aplicația: npm run dev
# 9. Pornește serverul email: node server-email.js
